# Compiler: Apple clang (xcode-select --install)
CC = clang++ -std=c++17 -target arm64-apple-macos11
# Comment this line if Boinc is not needed
BOINC = true

RM = rm

ROOT_DIR = ..

BIN_DIR = $(ROOT_DIR)/bin
SRC_DIR = $(ROOT_DIR)/src

# GMP source code: https://gmplib.org/download/gmp/gmp-6.3.0.tar.xz
# ./configure --disable-shared CC="clang -target arm64-apple-macos11"
# make => gmp.h .libs/libgmp.a
GMP_DIR = $(ROOT_DIR)/../gmp
GMP_INC = -I$(GMP_DIR)
GMP_LIB = $(GMP_DIR)/.libs/libgmp.a

OCL_INC = -I$(ROOT_DIR)/Khronos
OCL_LIB = -framework OpenCL

ifdef BOINC
# BOINC source code: https://github.com/BOINC/boinc/archive/refs/tags/client_release/8.2/8.2.9.zip
BOINC_DIR = $(ROOT_DIR)/../boinc
BOINC_INC = -I$(BOINC_DIR) -I$(BOINC_DIR)/api -I$(BOINC_DIR)/lib
BOINC_LIB_DIR = $(BOINC_DIR)/mac_build/build/Deployment
BOINC_LIB = $(BOINC_LIB_DIR)/libboinc_api.a $(BOINC_LIB_DIR)/libboinc.a
BOINC_LIB_OCL = $(BOINC_LIB_DIR)/libboinc_opencl.a
endif

CFLAGS = -Wall -Wextra -Wsign-conversion
ifdef BOINC
CFLAGS += -DBOINC $(BOINC_INC)
endif
OFLAGS = -ffinite-math-only -ffp-contract=fast -fno-trapping-math -fno-signed-zeros
FLAGS_CPU = -O3
FLAGS_GPU = -O3 -DGPU

OBJS_CPU = main.o transform_neon.o
OBJS_GPU = maing.o transform_ocl.o
DEPS_COMMON = $(SRC_DIR)/transform.h $(SRC_DIR)/file.h $(SRC_DIR)/gint.h $(SRC_DIR)/pio.h $(SRC_DIR)/boinc.h
DEPS_MAIN = $(SRC_DIR)/genefer.h $(SRC_DIR)/timer.h $(DEPS_COMMON)
DEPS_TRANSFORM_CPUf64 = $(SRC_DIR)/transformCPUf64.h $(SRC_DIR)/transformCPUf64s.h $(SRC_DIR)/parallel.h $(SRC_DIR)/f64vector.h $(SRC_DIR)/f64vector_pair.h $(SRC_DIR)/simd128d.h $(SRC_DIR)/simd256d.h $(SRC_DIR)/simd512d.h $(DEPS_COMMON)
DEPS_TRANSFORM_GPU = $(SRC_DIR)/transformGPU.h $(SRC_DIR)/ocl.h $(DEPS_COMMON)

EXEC_CPU = $(BIN_DIR)/genefer_mac_arm
EXEC_GPU = $(BIN_DIR)/geneferg_mac_arm

.PHONY: all clean_obj clean_bin rebuild

all: $(EXEC_CPU) $(EXEC_GPU)

clean_obj:
	$(RM) $(OBJS_CPU) $(OBJS_GPU)

clean_bin:
	$(RM) $(EXEC_CPU) $(EXEC_GPU)

rebuild: clean_obj clean_bin all

main.o: $(SRC_DIR)/main.cpp $(DEPS_MAIN)
	$(CC) $(CFLAGS) $(FLAGS_CPU) $(GMP_INC) -c $< -o $@

maing.o: $(SRC_DIR)/main.cpp $(DEPS_MAIN)
	$(CC) $(CFLAGS) $(FLAGS_GPU) $(GMP_INC) $(OCL_INC) -c $< -o $@

transform_neon.o: $(SRC_DIR)/transform_neon.cpp $(DEPS_TRANSFORM_CPUf64)
	$(CC) $(CFLAGS) $(OFLAGS) $(FLAGS_CPU) $(GMP_INC) -c $< -o $@

transform_ocl.o: $(SRC_DIR)/transform_ocl.cpp $(DEPS_TRANSFORM_GPU)
	$(CC) $(CFLAGS) $(FLAGS_GPU) $(GMP_INC) $(OCL_INC) -c $< -o $@

$(EXEC_CPU): $(OBJS_CPU)
	$(CC) $(FLAGS_CPU) $^ $(GMP_LIB) $(BOINC_LIB) -o $@

$(EXEC_GPU): $(OBJS_GPU)
	$(CC) $(FLAGS_GPU) $^ $(GMP_LIB) $(BOINC_LIB) $(BOINC_LIB_OCL) $(OCL_LIB) -o $@
